# ═══════════════════════════════════════════════════════════════
# E-Cell NIT Silchar — Backend Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── URLs ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ── Database (MongoDB Atlas) ─────────────────────────────────
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/ecell?retryWrites=true&w=majority

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email Service (Brevo / Sendinblue) ───────────────────────
BREVO_API_KEY=
BREVO_EMAIL=

# ── Cloudinary (Image/File Uploads) ─────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
